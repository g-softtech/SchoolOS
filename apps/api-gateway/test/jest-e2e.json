{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "globalSetup": "<rootDir>/identity-certification/setup/certification.setup.ts",
  "testRegex": ".*\\.(e2e-spec|spec)\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "reporters": [
    "default",
    ["jest-junit", { "outputDirectory": "test-results", "outputName": "identity-certification.xml" }]
  ]
}
