{
  "name": "saas-platform",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "bootstrap": "pnpm install --frozen-lockfile",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:cov": "jest --coverage",
    "lint": "turbo run lint",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "validate:architecture": "dependency-cruiser --config .dependency-cruiser.js apps packages",
    "check:security": "gitleaks detect --verbose && pnpm audit --audit-level=high",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "latest",
    "@commitlint/config-conventional": "latest",
    "@types/jest": "^30.0.0",
    "@types/supertest": "^7.0.0",
    "dependency-cruiser": "latest",
    "husky": "latest",
    "ioredis-mock": "^8.13.1",
    "jest": "^30.0.0",
    "jest-junit": "^17.0.0",
    "jest-mock-extended": "^4.0.1",
    "lint-staged": "latest",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "turbo": "latest",
    "typescript": "latest"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "prisma",
      "@prisma/engines",
      "sharp"
    ]
  }
}
