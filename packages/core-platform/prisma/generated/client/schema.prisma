datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

// ==================================================
// DOMAIN 1: PLATFORM (Global Models)
// ==================================================

model PlatformPlan {
  id           String  @id @default(uuid())
  name         String // e.g., Starter, Pro, Enterprise
  price        Decimal
  entitlements Json // JSON config of unlocked features

  tenants       Tenant[]
  subscriptions PlatformSubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("plt_platform_plans")
}

model Tenant {
  id     String       @id @default(uuid())
  name   String
  slug   String       @unique
  status TenantStatus @default(ACTIVE)
  planId String
  plan   PlatformPlan @relation(fields: [planId], references: [id])

  subscriptions   PlatformSubscription[]
  domains         TenantDomain[]
  branding        TenantBranding?
  settings        TenantSettings?
  marketplaceApps TenantMarketplaceApp[]
  featureFlags    FeatureFlag[]

  memberships TenantMembership[]
  roles       Role[]
  auditLogs   AuditLog[]

  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  deletedAt          DateTime?
  Campus             Campus[]
  AcademicYear       AcademicYear[]
  Term               Term[]
  Department         Department[]
  Class              Class[]
  Arm                Arm[]
  SubjectGroup       SubjectGroup[]
  Subject            Subject[]
  Timetable          Timetable[]
  Student            Student[]
  Guardian           Guardian[]
  Admission          Admission[]
  MedicalRecord      MedicalRecord[]
  DisciplineRecord   DisciplineRecord[]
  Attendance         Attendance[]
  Staff              Staff[]
  Employment         Employment[]
  Payroll            Payroll[]
  LeaveRequest       LeaveRequest[]
  FeeCategory        FeeCategory[]
  Invoice            Invoice[]
  Payment            Payment[]
  Expense            Expense[]
  Income             Income[]
  Scholarship        Scholarship[]
  Exam               Exam[]
  Result             Result[]
  Assignment         Assignment[]
  LessonNote         LessonNote[]
  Website            Website?
  Page               Page[]
  NavigationMenu     NavigationMenu[]
  AIProviderConfig   AIProviderConfig[]
  AIUsageLog         AIUsageLog[]
  PromptTemplate     PromptTemplate[]
  Hostel             Hostel[]
  TransportVehicle   TransportVehicle[]
  LibraryBook        LibraryBook[]
  NotificationQueue  NotificationQueue[]
  PaymentAttempt     PaymentAttempt[]
  PaymentAllocation  PaymentAllocation[]
  PaymentPlanVersion PaymentPlanVersion[]
  ApprovalWorkflow   ApprovalWorkflow[]
  ScheduledJob       ScheduledJob[]
  SequenceGenerator  SequenceGenerator[]

  AdmissionCampaign         AdmissionCampaign[]
  AdmissionWorkflow         AdmissionWorkflow[]
  AdmissionForm             AdmissionForm[]
  AdmissionRequiredDocument AdmissionRequiredDocument[]
  AdmissionApplication      AdmissionApplication[]

  @@map("plt_tenants")
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  INACTIVE
}

model PlatformSubscription {
  id       String       @id @default(uuid())
  tenantId String
  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId   String
  plan     PlatformPlan @relation(fields: [planId], references: [id])

  status           SubStatus @default(ACTIVE)
  currentPeriodEnd DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("plt_platform_subscriptions")
}

enum SubStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

model MarketplaceApp {
  id          String @id @default(uuid())
  appCode     String @unique // e.g., 'library', 'hostel'
  name        String
  description String

  tenantApps TenantMarketplaceApp[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("plt_marketplace_apps")
}

model TenantMarketplaceApp {
  id       String         @id @default(uuid())
  tenantId String
  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appId    String
  app      MarketplaceApp @relation(fields: [appId], references: [id], onDelete: Cascade)

  enabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, appId])
  @@index([tenantId])
  @@map("plt_tenant_marketplace_apps")
}

model TenantDomain {
  id       String  @id @default(uuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  domain   String  @unique // e.g., school.com
  verified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("plt_tenant_domains")
}

model TenantBranding {
  id             String  @id @default(uuid())
  tenantId       String  @unique
  tenant         Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  logoUrl        String?
  faviconUrl     String?
  primaryColor   String?
  secondaryColor String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("plt_tenant_branding")
}

model TenantSettings {
  id         String @id @default(uuid())
  tenantId   String @unique
  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  timezone   String @default("UTC")
  dateFormat String @default("YYYY-MM-DD")
  currency   String @default("USD")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("plt_tenant_settings")
}

model FeatureFlag {
  id       String  @id @default(uuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feature  String
  enabled  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, feature])
  @@index([tenantId])
  @@map("plt_feature_flags")
}

model AuditSeed {
  id        String   @id @default(uuid())
  version   String
  appliedAt DateTime @default(now())

  @@map("plt_audit_seeds")
}

// ==================================================
// DOMAIN 2: IDENTITY (Global Users & Tenant Isolation)
// ==================================================

model User {
  id                String     @id @default(uuid())
  email             String     @unique
  passwordHash      String?
  globalRole        GlobalRole @default(USER)
  emailVerified     DateTime?
  preferredTenantId String?

  memberships TenantMembership[]
  sessions    Session[]
  auditLogs   AuditLog[]

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime?
  AIUsageLog        AIUsageLog[]
  NotificationQueue NotificationQueue[]

  @@map("idm_users")
}

enum GlobalRole {
  SUPER_ADMIN
  USER
}

enum MembershipState {
  PENDING
  ACTIVE
  REVOKED
  SUSPENDED
}

enum IdentityState {
  PROVISIONED
  PENDING_ACTIVATION
  ACTIVE
  SUSPENDED
  ARCHIVED
  OFFBOARDED
}

model LifecycleTransition {
  id                 String           @id @default(uuid())
  tenantMembershipId String
  membership         TenantMembership @relation(fields: [tenantMembershipId], references: [id], onDelete: Cascade)
  fromState          String
  toState            String
  correlationId      String?
  reason             String?
  actorId            String?
  createdAt          DateTime         @default(now())

  @@index([tenantMembershipId])
  @@map("idm_lifecycle_transitions")
}

model TenantMembership {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId   String
  role     Role   @relation(fields: [roleId], references: [id])

  // Lifecycle & State
  state     IdentityState @default(PROVISIONED)
  isRevoked Boolean       @default(false)
  revokedAt DateTime?
  revokedBy String?
  version   Int           @default(1)

  lifecycleTransitions LifecycleTransition[]

  profile Profile?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Connections to Domains
  student  Student?
  staff    Staff?
  guardian Guardian?

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@map("idm_tenant_memberships")
}

model Profile {
  id                 String           @id @default(uuid())
  tenantMembershipId String           @unique
  membership         TenantMembership @relation(fields: [tenantMembershipId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String
  phone     String?
  avatarUrl String?
  dob       DateTime?
  gender    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("idm_profiles")
}

model Role {
  id       String  @id @default(uuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name     String // e.g., "SCHOOL_ADMIN", "TEACHER"
  isSystem Boolean @default(false)

  permissions RolePermission[]
  memberships TenantMembership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("idm_roles")
}

model Permission {
  id          String  @id @default(uuid())
  name        String  @unique // e.g., "users:read", "fees:write"
  description String?

  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("idm_permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([roleId, permissionId])
  @@map("idm_role_permissions")
}

enum SessionState {
  ACTIVE
  REVOKED
  EXPIRED
  LOGGED_OUT
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime

  // Security Tracking
  ip        String?
  userAgent String?
  device    String?
  lastSeen  DateTime?
  state     SessionState @default(ACTIVE)

  // Metadata
  fingerprint String?
  isRevoked   Boolean @default(false)
  mfaVerified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("idm_sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("idm_verification_tokens")
}

model AuditLog {
  id       String  @id @default(uuid())
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String?
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  action   String // e.g., "FEE_PAID", "USER_CREATED"
  entity   String // e.g., "Invoice", "User"
  entityId String
  metadata Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([tenantId, entity, entityId])
  @@map("idm_audit_logs")
}

// ==================================================
// DOMAIN 3: ACADEMIC STRUCTURE
// ==================================================

model Campus {
  id       String  @id @default(uuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name     String
  address  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("acd_campuses")
}

model AcademicYear {
  id        String     @id @default(uuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String // e.g., "2026/2027"
  startDate DateTime
  endDate   DateTime
  status    YearStatus @default(UPCOMING)

  terms              Term[]
  admissionCampaigns AdmissionCampaign[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("acd_academic_years")
}

enum YearStatus {
  UPCOMING
  ACTIVE
  PAST
}

model Term {
  id             String       @id @default(uuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  name           String // e.g., "Fall Term"
  startDate      DateTime
  endDate        DateTime

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  Timetable Timetable[]
  Invoice   Invoice[]
  Exam      Exam[]

  @@index([tenantId, academicYearId])
  @@map("acd_terms")
}

model Department {
  id          String       @id @default(uuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  name        String
  description String?
  parentId    String?
  parent      Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children    Department[] @relation("DepartmentHierarchy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees Staff[]

  @@unique([tenantId, name])
  @@map("hrm_departments")
}

model Class {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name     String // e.g., "Grade 10"
  level    Int

  arms     Arm[]
  subjects Subject[]

  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  Assignment Assignment[]

  @@index([tenantId])
  @@map("acd_classes")
}

model Arm {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classId  String
  class    Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  name     String // e.g., "10A"
  capacity Int?

  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  Timetable  Timetable[]
  Student    Student[]
  Attendance Attendance[]

  @@unique([classId, name])
  @@index([tenantId])
  @@map("acd_arms")
}

model SubjectGroup {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name     String // e.g., "Sciences"

  subjects Subject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("acd_subject_groups")
}

model Subject {
  id             String        @id @default(uuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  code           String
  subjectGroupId String?
  subjectGroup   SubjectGroup? @relation(fields: [subjectGroupId], references: [id])

  classes Class[]

  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  Exam       Exam[]
  Assignment Assignment[]
  LessonNote LessonNote[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("acd_subjects")
}

model Timetable {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  armId    String
  arm      Arm    @relation(fields: [armId], references: [id], onDelete: Cascade)
  termId   String
  term     Term   @relation(fields: [termId], references: [id], onDelete: Cascade)

  config Json // JSON representing schedule blocks

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  TimetableSlot TimetableSlot[]

  @@index([tenantId, armId, termId])
  @@map("acd_timetables")
}

// ==================================================
// DOMAIN 4: STUDENT DOMAIN
// ==================================================

model Student {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Link to the Identity Domain
  membershipId String           @unique
  membership   TenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  admissionNumber String
  enrollmentDate  DateTime @default(now())

  // Link to Academic Domain
  currentArmId String?
  currentArm   Arm?    @relation(fields: [currentArmId], references: [id])

  guardians         StudentGuardian[]
  admissions        Admission[]
  medicalRecords    MedicalRecord[]
  disciplineRecords DisciplineRecord[]
  attendance        Attendance[]

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  Invoice       Invoice[]
  Scholarship   Scholarship[]
  Result        Result[]
  BedAllocation BedAllocation[]
  BookBorrowing BookBorrowing[]

  @@unique([tenantId, admissionNumber])
  @@index([tenantId])
  @@map("std_students")
}

model Guardian {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Link to the Identity Domain
  membershipId String           @unique
  membership   TenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  students StudentGuardian[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("std_guardians")
}

model StudentGuardian {
  id         String   @id @default(uuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardianId String
  guardian   Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  relationship GuardianRelationship

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, guardianId])
  @@map("std_student_guardians")
}

enum GuardianRelationship {
  FATHER
  MOTHER
  SIBLING
  UNCLE
  AUNT
  GRANDPARENT
  OTHER
}

model Admission {
  id        String  @id @default(uuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  status          AdmissionStatus @default(PENDING)
  applicationDate DateTime        @default(now())
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, studentId])
  @@map("std_admissions")
}

enum AdmissionStatus {
  PENDING
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  WAITLISTED
}

model MedicalRecord {
  id        String  @id @default(uuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  bloodGroup        String?
  genotype          String?
  allergies         String?
  medicalConditions String?
  notes             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, studentId])
  @@map("std_medical_records")
}

model DisciplineRecord {
  id        String  @id @default(uuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  incidentDate DateTime
  description  String
  actionTaken  String?
  severity     IncidentSeverity @default(MINOR)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, studentId])
  @@map("std_discipline_records")
}

enum IncidentSeverity {
  MINOR
  MAJOR
  SEVERE
}

model Attendance {
  id        String  @id @default(uuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  armId String
  arm   Arm    @relation(fields: [armId], references: [id])

  date    DateTime
  status  AttendanceStatus
  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, studentId, date])
  @@index([tenantId, studentId])
  @@map("std_attendance")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

// ==================================================
// DOMAIN 5: STAFF & HR DOMAIN
// ==================================================

model Staff {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  membershipId String           @unique
  membership   TenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  staffIdNumber String
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id])
  designation   String?

  employment     Employment?
  payrollRecords Payroll[]
  leaveRequests  LeaveRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, staffIdNumber])
  @@index([tenantId])
  @@map("stf_staff")
}

model Employment {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staffId  String @unique
  staff    Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  hireDate        DateTime
  terminationDate DateTime?
  status          EmploymentStatus @default(ACTIVE)
  contractType    String? // e.g., FULL_TIME, PART_TIME, CONTRACT

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("stf_employment")
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
  SUSPENDED
}

model Payroll {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staffId  String
  staff    Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  periodStart DateTime
  periodEnd   DateTime
  baseSalary  Decimal
  deductions  Decimal       @default(0.0)
  bonuses     Decimal       @default(0.0)
  netPay      Decimal
  status      PaymentStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, staffId])
  @@map("stf_payroll")
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

model LeaveRequest {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staffId  String
  staff    Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  type      LeaveType
  startDate DateTime
  endDate   DateTime
  reason    String?
  status    LeaveStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, staffId])
  @@map("stf_leave_requests")
}

enum LeaveType {
  SICK
  ANNUAL
  MATERNITY
  UNPAID
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELED
}

// ==================================================
// DOMAIN 6: FINANCE DOMAIN
// ==================================================

model FeeCategory {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name        String // e.g., "Tuition", "Transport"
  description String?
  amount      Decimal
  mandatory   Boolean @default(true)

  invoices InvoiceItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("fin_fee_categories")
}

model Invoice {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  termId    String
  term      Term    @relation(fields: [termId], references: [id])

  invoiceNumber String
  totalAmount   Decimal
  amountPaid    Decimal       @default(0.0)
  status        InvoiceStatus @default(DRAFT)
  dueDate       DateTime

  items    InvoiceItem[]
  payments Payment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, studentId])
