  status    String // PENDING, RUNNING, COMPLETED, FAILED
  payload   Json?
  logs      Json?
  lastRunAt DateTime?
  nextRunAt DateTime
  retries   Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status, nextRunAt])
  @@map("core_scheduled_jobs")
}

