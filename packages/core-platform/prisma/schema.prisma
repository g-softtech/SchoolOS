datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

// ==================================================
// DOMAIN 1: PLATFORM (Global Models)
// ==================================================

model PlatformPlan {
  id           String  @id @default(uuid())
  name         String // e.g., Starter, Pro, Enterprise
  price        Decimal
  entitlements Json // JSON config of unlocked features

  tenants       Tenant[]
  subscriptions PlatformSubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("plt_platform_plans")
}

model Tenant {
  id     String       @id @default(uuid())
  name   String
  slug   String       @unique
  status TenantStatus @default(ACTIVE)
  planId String
  plan   PlatformPlan @relation(fields: [planId], references: [id])

  subscriptions   PlatformSubscription[]
  domains         TenantDomain[]
  branding        TenantBranding?
  settings        TenantSettings?
  marketplaceApps TenantMarketplaceApp[]
  featureFlags    FeatureFlag[]

  memberships TenantMembership[]
  roles       Role[]
  auditLogs   AuditLog[]

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  deletedAt        DateTime?
  Campus           Campus[]
  AcademicYear     AcademicYear[]
  Term             Term[]
  Department       Department[]
  Class            Class[]
  Arm              Arm[]
  SubjectGroup     SubjectGroup[]
  Subject          Subject[]
  Timetable        Timetable[]
  Student          Student[]
  Guardian         Guardian[]
  Admission        Admission[]
  MedicalRecord    MedicalRecord[]
  DisciplineRecord DisciplineRecord[]
  Attendance       Attendance[]

  @@map("plt_tenants")
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  INACTIVE
}

model PlatformSubscription {
  id       String       @id @default(uuid())
  tenantId String
  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId   String
  plan     PlatformPlan @relation(fields: [planId], references: [id])

  status           SubStatus @default(ACTIVE)
  currentPeriodEnd DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("plt_platform_subscriptions")
}

enum SubStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

model MarketplaceApp {
  id          String @id @default(uuid())
  appCode     String @unique // e.g., 'library', 'hostel'
  name        String
  description String

  tenantApps TenantMarketplaceApp[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("plt_marketplace_apps")
}

model TenantMarketplaceApp {
  id       String         @id @default(uuid())
  tenantId String
  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appId    String
  app      MarketplaceApp @relation(fields: [appId], references: [id], onDelete: Cascade)

  enabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, appId])
  @@index([tenantId])
  @@map("plt_tenant_marketplace_apps")
}

model TenantDomain {
  id       String  @id @default(uuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  domain   String  @unique // e.g., school.com
  verified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("plt_tenant_domains")
}

model TenantBranding {
  id             String  @id @default(uuid())
  tenantId       String  @unique
  tenant         Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  logoUrl        String?
  faviconUrl     String?
  primaryColor   String?
  secondaryColor String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("plt_tenant_branding")
}

model TenantSettings {
  id         String @id @default(uuid())
  tenantId   String @unique
  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  timezone   String @default("UTC")
  dateFormat String @default("YYYY-MM-DD")
  currency   String @default("USD")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("plt_tenant_settings")
}

model FeatureFlag {
  id       String  @id @default(uuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feature  String
  enabled  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, feature])
  @@index([tenantId])
  @@map("plt_feature_flags")
}

model AuditSeed {
  id        String   @id @default(uuid())
  version   String
  appliedAt DateTime @default(now())

  @@map("plt_audit_seeds")
}

// ==================================================
// DOMAIN 2: IDENTITY (Global Users & Tenant Isolation)
// ==================================================

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  passwordHash  String?
  globalRole    GlobalRole @default(USER)
  emailVerified DateTime?

  memberships TenantMembership[]
  sessions    Session[]
  auditLogs   AuditLog[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("idm_users")
}

enum GlobalRole {
  SUPER_ADMIN
  USER
}

model TenantMembership {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId   String
  role     Role   @relation(fields: [roleId], references: [id])

  profile Profile?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  Student   Student?
  Guardian  Guardian?

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@map("idm_tenant_memberships")
}

model Profile {
  id                 String           @id @default(uuid())
  tenantMembershipId String           @unique
  membership         TenantMembership @relation(fields: [tenantMembershipId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String
  phone     String?
  avatarUrl String?
  dob       DateTime?
  gender    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("idm_profiles")
}

model Role {
  id       String  @id @default(uuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name     String // e.g., "SCHOOL_ADMIN", "TEACHER"
  isSystem Boolean @default(false)

  permissions RolePermission[]
  memberships TenantMembership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("idm_roles")
}

model Permission {
  id          String  @id @default(uuid())
  name        String  @unique // e.g., "users:read", "fees:write"
  description String?

  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("idm_permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([roleId, permissionId])
  @@map("idm_role_permissions")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("idm_sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("idm_verification_tokens")
}

model AuditLog {
  id       String  @id @default(uuid())
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String?
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  action   String // e.g., "FEE_PAID", "USER_CREATED"
  entity   String // e.g., "Invoice", "User"
  entityId String
  metadata Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([tenantId, entity, entityId])
  @@map("idm_audit_logs")
}

// ==================================================
// DOMAIN 3: ACADEMIC STRUCTURE
// ==================================================

model Campus {
  id       String  @id @default(uuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name     String
  address  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("acd_campuses")
}

model AcademicYear {
  id        String     @id @default(uuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String // e.g., "2026/2027"
  startDate DateTime
  endDate   DateTime
  status    YearStatus @default(UPCOMING)

  terms Term[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("acd_academic_years")
}

enum YearStatus {
  UPCOMING
  ACTIVE
  PAST
}

model Term {
  id             String       @id @default(uuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  name           String // e.g., "Fall Term"
  startDate      DateTime
  endDate        DateTime

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  Timetable Timetable[]

  @@index([tenantId, academicYearId])
  @@map("acd_terms")
}

model Department {
  id       String  @id @default(uuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name     String
  headId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("acd_departments")
}

model Class {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name     String // e.g., "Grade 10"
  level    Int

  arms     Arm[]
  subjects Subject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("acd_classes")
}

model Arm {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classId  String
  class    Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  name     String // e.g., "10A"
  capacity Int?

  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  Timetable  Timetable[]
  Student    Student[]
  Attendance Attendance[]

  @@unique([classId, name])
  @@index([tenantId])
  @@map("acd_arms")
}

model SubjectGroup {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name     String // e.g., "Sciences"

  subjects Subject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("acd_subject_groups")
}

model Subject {
  id             String        @id @default(uuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  code           String
  subjectGroupId String?
  subjectGroup   SubjectGroup? @relation(fields: [subjectGroupId], references: [id])

  classes Class[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("acd_subjects")
}

model Timetable {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  armId    String
  arm      Arm    @relation(fields: [armId], references: [id], onDelete: Cascade)
  termId   String
  term     Term   @relation(fields: [termId], references: [id], onDelete: Cascade)

  config Json // JSON representing schedule blocks

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, armId, termId])
  @@map("acd_timetables")
}

// ==================================================
// DOMAIN 4: STUDENT DOMAIN
// ==================================================

model Student {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Link to the Identity Domain
  membershipId String           @unique
  membership   TenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  admissionNumber String
  enrollmentDate  DateTime @default(now())

  // Link to Academic Domain
  currentArmId String?
  currentArm   Arm?    @relation(fields: [currentArmId], references: [id])

  guardians         StudentGuardian[]
  admissions        Admission[]
  medicalRecords    MedicalRecord[]
  disciplineRecords DisciplineRecord[]
  attendance        Attendance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, admissionNumber])
  @@index([tenantId])
  @@map("std_students")
}

model Guardian {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Link to the Identity Domain
  membershipId String           @unique
  membership   TenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  students StudentGuardian[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("std_guardians")
}

model StudentGuardian {
  id         String   @id @default(uuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardianId String
  guardian   Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  relationship GuardianRelationship

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, guardianId])
  @@map("std_student_guardians")
}

enum GuardianRelationship {
  FATHER
  MOTHER
  SIBLING
  UNCLE
  AUNT
  GRANDPARENT
  OTHER
}

model Admission {
  id        String  @id @default(uuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  status          AdmissionStatus @default(PENDING)
  applicationDate DateTime        @default(now())
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, studentId])
  @@map("std_admissions")
}

enum AdmissionStatus {
  PENDING
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  WAITLISTED
}

model MedicalRecord {
  id        String  @id @default(uuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  bloodGroup        String?
  genotype          String?
  allergies         String?
  medicalConditions String?
  notes             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, studentId])
  @@map("std_medical_records")
}

model DisciplineRecord {
  id        String  @id @default(uuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  incidentDate DateTime
  description  String
  actionTaken  String?
  severity     IncidentSeverity @default(MINOR)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, studentId])
  @@map("std_discipline_records")
}

enum IncidentSeverity {
  MINOR
  MAJOR
  SEVERE
}

model Attendance {
  id        String  @id @default(uuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  armId String
  arm   Arm    @relation(fields: [armId], references: [id])

  date    DateTime
  status  AttendanceStatus
  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, studentId, date])
  @@index([tenantId, studentId])
  @@map("std_attendance")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}
